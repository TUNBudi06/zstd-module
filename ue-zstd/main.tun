# Default: interactive menu (choose import / reimport).
# Shortcut: --reimport skips the menu and repacks directly.
START {
    arg @reimport = "--reimport" flag : "Skip the menu and repack directly";
}
LOAD { load "lib/zstd"; }
MAIN {
    if @reimport == 1 { run "scripts/repack"; }
    else { run "scripts/menu"; }
}
