# Pick at launch:
#   quicktzs dev run main.tun              -> unpack (import)
#   quicktzs dev run main.tun --reimport   -> repack (reimport)
START {
    arg @reimport = "--reimport" flag : "Rebuild the archive from extracted files (default: unpack)";
}
LOAD { load "lib/zstd"; }
MAIN {
    if @reimport == 1 { run "scripts/repack"; }
    else { run "scripts/unpack"; }
}
